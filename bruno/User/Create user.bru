meta {
  name: Create user
  type: http
  seq: 11
}

post {
  url: {{url}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "example1@gmail.com",
    "password": "{{default_password}}",
    "username": "Example1",
    "firstName": "Ex",
    "lastName": "Example",
    "phoneNumber": "+407777777777"
  }
}
