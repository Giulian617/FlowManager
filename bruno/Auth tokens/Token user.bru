meta {
  name: Token user
  type: http
  seq: 4
}

post {
  url: http://localhost:8080/realms/flowmanager/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: flowmanager-client
  client_secret: {{client_secret}}
  username: example1
  password: {{default_password}}
}
