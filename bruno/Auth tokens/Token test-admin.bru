meta {
  name: Token test-admin
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/realms/flowmanager/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: flowmanager-client
  client_secret: {{client_secret}}
  username: test-admin
  password: {{Admin_password}}
}
